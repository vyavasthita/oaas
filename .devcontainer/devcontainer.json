// OAAS Dev Container — Observability stack workspace
// Opens a lightweight shell connected to all observability services.
// All 9 services (Grafana, Prometheus, Loki, Tempo, etc.) start automatically.
{
  "name": "OAAS",
  "dockerComposeFile": [
    "../docker-compose.yaml",
    "docker-compose.devcontainer.yaml"
  ],
  "service": "workspace",
  "workspaceFolder": "/workspace",

  // Runs on the HOST before any container is built.
  // Creates the shared Docker network so all repos can communicate.
  "initializeCommand": "docker network create oaas-observability-net 2>/dev/null || true",

  // Runs inside container after first creation.
  "postCreateCommand": "echo 'OAAS workspace ready. All observability services are starting.'",

  "forwardPorts": [1001, 1002, 1003, 1004, 1005, 1006, 1010],
  "portsAttributes": {
    "1001": { "label": "Grafana", "onAutoForward": "notify" },
    "1002": { "label": "Prometheus", "onAutoForward": "silent" },
    "1003": { "label": "Alertmanager", "onAutoForward": "silent" },
    "1004": { "label": "Loki", "onAutoForward": "silent" },
    "1005": { "label": "Tempo", "onAutoForward": "silent" },
    "1006": { "label": "Jaeger", "onAutoForward": "silent" },
    "1010": { "label": "OTel Collector HTTP", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ]
    }
  },

  "shutdownAction": "stopCompose"
}
